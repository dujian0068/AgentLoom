# Copy to .env; the local environment overrides this file.
DB_BACKEND=postgresql
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=agentloom
DB_USER=agentloom
DB_PASSWORD=
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
# Use DB_BACKEND=sqlite explicitly for offline local development.
# Keep the SSH tunnel open while using the application.

# File tools use a session workspace; local is for single-node development.
AGENT_LOOM_WORKSPACE_BACKEND=local
# AGENT_LOOM_WORKSPACE_ROOT=/absolute/local/workspaces
# Shared deployment: mount NFS/NAS on the worker before choosing shared_posix.
# The existing root/.agentloom-volume must contain the configured volume ID.
# AGENT_LOOM_WORKSPACE_BACKEND=shared_posix
# AGENT_LOOM_WORKSPACE_ROOT=/mnt/agentloom-workspaces
# AGENT_LOOM_WORKSPACE_VOLUME_ID=agentloom-team-volume-v1
# Preload a trusted image. The runtime never pulls images during tool execution.
AGENT_LOOM_SANDBOX_IMAGE=python:3.12-slim
# AGENT_LOOM_SANDBOX_RUNTIME=runsc
# AGENT_LOOM_DOCKER_HOST=unix:///var/run/docker.sock
# Details: docs/system-tools-shared-workspace-v0.1.md
